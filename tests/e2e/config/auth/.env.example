# Copy to .env.local / .env.sit / .env.uat and fill in.
# These files are gitignored. environment.yaml (tracked) must never contain a secret.
# Every key that any environment needs must appear here, blank — this file is the contract
# that tells a new machine what to provision.

# API authentication
API_TOKEN=
API_CLIENT_ID=
API_CLIENT_SECRET=

# Test user credentials (UI login)
TEST_USER=
TEST_PASSWORD=

# Database (level:db verification + seed script)
DB_USER=
DB_PASSWORD=
