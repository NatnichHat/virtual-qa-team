# Root-level secrets for developer-side TOOLING — distinct from tests/e2e/config/auth/.env.<env>,
# which holds per-environment secrets for the automation SUITE. This file is for scripts run by a
# human on their own machine before the pipeline starts (e.g. scripts/import/fetch-jira.py).
#
# Copy to .env (gitignored) and fill in.

# Jira — used to import stories (read-only) and, once docs/test_stack.md's defect_tracker is
# configured, to file D1 tickets at G7.
JIRA_SITE=https://yourcompany.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=
